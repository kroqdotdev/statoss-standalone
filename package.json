{
  "name": "statoss-standalone",
  "version": "0.1.0",
  "description": "Self-hosted status page in one container: uptime checks, SQLite storage, a public page for each site, and email alerts.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kroqdotdev/statoss-standalone.git"
  },
  "homepage": "https://github.com/kroqdotdev/statoss-standalone#readme",
  "bugs": {
    "url": "https://github.com/kroqdotdev/statoss-standalone/issues"
  },
  "keywords": [
    "status-page",
    "uptime",
    "monitoring",
    "self-hosted",
    "nextjs",
    "sqlite",
    "docker"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "16.3.4",
    "nodemailer": "^10.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
