{
  "name": "statoss-standalone",
  "version": "0.3.0",
  "description": "Self-hosted status page in one container: uptime checks, SQLite storage, a public page for each site, and email alerts.",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kroqdotdev/statoss-standalone.git"
  },
  "homepage": "https://github.com/kroqdotdev/statoss-standalone#readme",
  "bugs": {
    "url": "https://github.com/kroqdotdev/statoss-standalone/issues"
  },
  "keywords": [
    "status-page",
    "uptime",
    "monitoring",
    "self-hosted",
    "nextjs",
    "sqlite",
    "docker"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "16.3.6",
    "nodemailer": "^10.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.7.0"
}
