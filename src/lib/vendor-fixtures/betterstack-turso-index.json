    {
      "id": "5528592",
      "type": "status_update",
      "attributes": {
        "message": "The router component is experiencing a high number of 502. At the moment, we only see databases in us-east-1 affected but are monitoring the situation and working on a mitigation",
        "published_at": "2026-08-04T22:18:00.000Z",
        "published_at_timezone": "Bogota",
        "notify_subscribers": true,
        "affected_resources": [
          {
            "status_page_resource_id": "1606861",
            "status": "degraded"
          },
          {
            "status_page_resource_id": "8547864",
            "status": "degraded"
          }
        ]
      }
    },
    {
      "id": "5528735",
      "type": "status_update",
      "attributes": {
        "message": "We had identified and resolved the issue. The issue was a software issue that brought a particular multitenant server down, which then cascaded due to retries to a load issue in the routing layer increasing the blast radius of the incident. We estimate that around 30 customers were affected and we deeply apologize for the disruption to those affected",
        "published_at": "2026-08-04T23:06:00.000Z",
        "published_at_timezone": "Bogota",
        "notify_subscribers": true,
        "affected_resources": [
          {
            "status_page_resource_id": "1606861",
            "status": "resolved"
          },
          {
            "status_page_resource_id": "8547864",
            "status": "resolved"
          }
        ]
      }
    },
